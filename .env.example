# OpenCode Warp Proxy - configuration
# Copy this file to `.env` and edit. Compose reads `.env` automatically.

# -----------------------------------------------------------------------------
# Auth mode
# -----------------------------------------------------------------------------
# Mode A (default, pass-through): leave OPENCODE_API_KEY empty.
#   Warp sends `Authorization: Bearer <key>` in every request.
#   The proxy forwards the header unchanged to opencode.ai.
#   -> Configure your real OpenCode Go API key in Warp's AI provider settings.
#
# Mode B (override): set OPENCODE_API_KEY below.
#   The proxy ignores the client's Authorization header and uses this value.
#   -> Useful if you do not want your real key stored in Warp's config files.
#      Put any placeholder value in Warp (the proxy will replace it).
#
# OPENCODE_API_KEY=

# -----------------------------------------------------------------------------
# Optional overrides
# -----------------------------------------------------------------------------
# Stable session id (recommended for prompt caching across proxy restarts).
# If unset, a random UUID is generated each time the container starts.
# SESSION_ID=

# User-Agent sent upstream. Must identify as a coding agent, not a generic
# SDK/HTTP client. OpenCode Go blocks generic user-agents.
# USER_AGENT=opencode-warp-proxy/1.0

# Listen port inside the container (also adjust the host port mapping in
# docker-compose.yml if you change this).
# PORT=8080

# Max request body size in bytes (default: 1048576 = 1 MB).
# Requests larger than this are rejected with 413 before reaching upstream.
# MAX_BODY_BYTES=1048576

# Per-request timeout in milliseconds (default: 60000 = 60s).
# Applies to both client and upstream. Hung connections are killed at this point.
# REQUEST_TIMEOUT_MS=60000
